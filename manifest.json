{
  "manifest_version": 3,
  "name": "SNATCHER",
  "version": "0.5.0",
  "description": "Send torrents and magnet links from any site to your own qBittorrent, Deluge, Transmission or ruTorrent, sorted into folders.",
  "permissions": ["storage", "contextMenus", "notifications", "scripting", "activeTab", "webRequest", "webRequestAuthProvider", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SNATCHER",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open or close the SNATCHER panel on this page"
    }
  }
}
