{
  "manifest_version": 3,
  "name": "SNATCHER",
  "version": "0.4.1",
  "description": "Send .torrent and magnet links from the page you're on to your ruTorrent clients, routed to the right folder by section.",
  "permissions": ["storage", "contextMenus", "notifications", "scripting", "activeTab", "webRequest", "webRequestAuthProvider", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SNATCHER",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open or close the SNATCHER panel on this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/common.js", "content.js", "panel.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
